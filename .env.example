# --- Tuya ---------------------------------------------------------------
TUYA_ACCESS_ID=
TUYA_SECRET_KEY=
TUYA_ENDPOINT=https://openapi.tuyaeu.com
TUYA_USER_ID=
# Optional: fallback hub id for IR remotes that don't report one
TUYA_IR_HUB_ID=

# --- Sign-in (required) -------------------------------------------------
# The same OAuth client id the frontend uses
GOOGLE_CLIENT_ID=
# The only Google account allowed in
ALLOWED_EMAIL=
# Long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Optional -----------------------------------------------------------
# Comma-separated list of frontend origins allowed by CORS
ALLOWED_ORIGINS=https://tuya-frontend.vercel.app,http://localhost:5173
# Persistent storage for schedules. Without it, a local JSON file is used
# (which Render's free plan wipes on every deploy/restart).
DATABASE_URL=
# How many minutes late a missed schedule may still run (default 5)
GRACE_MINUTES=5
TIME_ZONE=Asia/Jerusalem
PORT=5000
